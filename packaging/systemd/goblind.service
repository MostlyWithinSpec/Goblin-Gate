[Unit]
Description=Goblin Gate Management Daemon
After=dbus.service systemd-networkd.service network.target
Wants=dbus.service

[Service]
# goblind does not send sd_notify READY=1 and has no reload; it re-applies the
# running config itself on start.
Type=exec
Restart=on-failure
RestartSec=5
User=root
# nft converts schedule hours (meta hour) from its local time zone; goblind
# renders them in UTC already (internal/render/nft/schedule.go), so the nft
# it runs must not convert again. Logs are UTC anyway.
Environment=TZ=UTC
Group=root
LimitNOFILE=65536
# /run/goblind/api.sock: the root-only local API socket for the goblin CLI.
RuntimeDirectory=goblind
RuntimeDirectoryMode=0750
ExecStart=/usr/sbin/goblind --web-dir /usr/share/goblin-gate/web
TimeoutStopSec=10
# goblind needs root (nftables, tc, networkd, sysctl, APT sources), so the
# sandbox only takes away what it never uses. Package updates run in their
# own transient unit (systemd-run), outside these limits.
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
