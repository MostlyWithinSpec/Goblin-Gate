<?xml version="1.0"?>
<!-- Anonymized pfSense CE 2.7 style backup for the importer tests: made-up
     names, documentation addresses (192.0.2.0/24, 198.51.100.0/24,
     203.0.113.0/24, 2001:db8::/32) and a dummy SSH key. -->
<pfsense>
	<version>23.3</version>
	<system>
		<hostname>edge</hostname>
		<domain>home.example</domain>
		<timezone>EST</timezone>
		<timeservers>0.pool.ntp.example 1.pool.ntp.example</timeservers>
		<dnsserver>192.0.2.53</dnsserver>
		<dnsserver>192.0.2.54</dnsserver>
		<user>
			<name>admin</name>
			<bcrypt-hash>$2y$10$notarealhashnotarealhashnotarealhashnotarealhashnotare</bcrypt-hash>
			<authorizedkeys>c3NoLWVkMjU1MTkgQUFBQUMzTnphQzFsWkRJMU5URTVBQUFBSUFBQkFnTUVCUVlIQ0FrS0N3d05EZzhRRVJJVEZCVVdGeGdaR2hzY0hSNGYgYWRtaW5AZXhhbXBsZS50ZXN0</authorizedkeys>
		</user>
	</system>
	<interfaces>
		<wan>
			<enable></enable>
			<if>igb0</if>
			<descr><![CDATA[WAN]]></descr>
			<ipaddr>dhcp</ipaddr>
			<ipaddrv6>dhcp6</ipaddrv6>
			<dhcp6-ia-pd-len>8</dhcp6-ia-pd-len>
			<blockbogons></blockbogons>
			<spoofmac>00:11:22:33:44:55</spoofmac>
		</wan>
		<lan>
			<enable></enable>
			<if>igb1</if>
			<descr><![CDATA[LAN]]></descr>
			<ipaddr>192.168.10.1</ipaddr>
			<subnet>24</subnet>
			<ipaddrv6>track6</ipaddrv6>
			<track6-interface>wan</track6-interface>
			<track6-prefix-id>0</track6-prefix-id>
		</lan>
		<opt1>
			<enable></enable>
			<if>igb1.30</if>
			<descr><![CDATA[IoT Devices]]></descr>
			<ipaddr>192.168.30.1</ipaddr>
			<subnet>24</subnet>
			<ipaddrv6>track6</ipaddrv6>
			<track6-interface>wan</track6-interface>
			<track6-prefix-id>3</track6-prefix-id>
		</opt1>
		<opt3>
			<enable></enable>
			<if>igb3.99</if>
			<descr><![CDATA[Cameras]]></descr>
			<ipaddr>192.168.99.1</ipaddr>
			<subnet>24</subnet>
		</opt3>
		<opt2>
			<if>igb2</if>
			<descr><![CDATA[Lab]]></descr>
			<ipaddr>pppoe</ipaddr>
		</opt2>
	</interfaces>
	<vlans>
		<vlan>
			<if>igb1</if>
			<tag>30</tag>
			<vlanif>igb1.30</vlanif>
			<descr><![CDATA[iot]]></descr>
		</vlan>
		<vlan>
			<if>igb3</if>
			<tag>99</tag>
			<vlanif>igb3.99</vlanif>
		</vlan>
	</vlans>
	<aliases>
		<alias>
			<name>Kids_Devices</name>
			<type>host</type>
			<address>192.168.10.50 192.168.10.51 tablet.home.example</address>
			<descr><![CDATA[kids]]></descr>
		</alias>
		<alias>
			<name>NAS</name>
			<type>host</type>
			<address>192.168.10.5</address>
		</alias>
		<alias>
			<name>Blocked_Nets</name>
			<type>network</type>
			<address>198.51.100.0/24 NAS</address>
		</alias>
		<alias>
			<name>Web_Ports</name>
			<type>port</type>
			<address>80 443 8000:8080</address>
		</alias>
		<alias>
			<name>Bad_IPs</name>
			<type>urltable</type>
			<url>https://lists.example/bad-ips.txt</url>
		</alias>
	</aliases>
	<schedules>
		<schedule>
			<name>SchoolNights</name>
			<descr><![CDATA[bed time]]></descr>
			<timerange>
				<position>1,2,3,4,7</position>
				<hour>21:00-23:59</hour>
				<rangedescr></rangedescr>
			</timerange>
			<timerange>
				<position>1,2,3,4,5</position>
				<hour>0:00-6:30</hour>
			</timerange>
			<timerange>
				<month>12</month>
				<day>24</day>
				<hour>0:00-23:59</hour>
			</timerange>
		</schedule>
	</schedules>
	<filter>
		<rule>
			<type>pass</type>
			<interface>lan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>tcp</protocol>
			<source><any></any></source>
			<destination><network>lanip</network><port>443</port></destination>
			<descr><![CDATA[Anti-Lockout Rule]]></descr>
		</rule>
		<rule>
			<type>block</type>
			<interface>wan,opt1</interface>
			<floating>yes</floating>
			<quick>yes</quick>
			<direction>out</direction>
			<ipprotocol>inet</ipprotocol>
			<source><any></any></source>
			<destination><address>Blocked_Nets</address></destination>
			<log></log>
			<descr><![CDATA[Block bad nets]]></descr>
		</rule>
		<rule>
			<type>block</type>
			<interface>lan</interface>
			<ipprotocol>inet</ipprotocol>
			<source><address>Kids_Devices</address></source>
			<destination><any></any></destination>
			<sched>SchoolNights</sched>
			<descr><![CDATA[Kids bed time]]></descr>
		</rule>
		<rule>
			<type>reject</type>
			<interface>lan</interface>
			<ipprotocol>inet</ipprotocol>
			<source><any></any></source>
			<destination><address>Bad_IPs</address></destination>
			<descr><![CDATA[Block bad IPs]]></descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>lan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>tcp/udp</protocol>
			<source><network>lan</network></source>
			<destination><address>NAS</address><port>Web_Ports</port></destination>
			<descr><![CDATA[LAN to NAS web]]></descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>lan</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>udp</protocol>
			<source><any></any><port>5353</port></source>
			<destination><any></any></destination>
			<descr><![CDATA[mDNS from port]]></descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>lan</interface>
			<ipprotocol>inet</ipprotocol>
			<source><network>lan</network></source>
			<destination><not></not><network>opt1</network></destination>
			<descr><![CDATA[Not to IoT]]></descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>lan</interface>
			<ipprotocol>inet</ipprotocol>
			<gateway>VPN_GW</gateway>
			<source><address>192.168.10.60</address></source>
			<destination><any></any></destination>
			<descr><![CDATA[Via VPN]]></descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>lan</interface>
			<ipprotocol>inet</ipprotocol>
			<source><network>lan</network></source>
			<destination><any></any></destination>
			<descr><![CDATA[Default allow LAN to any rule]]></descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>lan</interface>
			<ipprotocol>inet6</ipprotocol>
			<source><any></any></source>
			<destination><any></any></destination>
			<descr><![CDATA[Default allow LAN IPv6 to any rule]]></descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>opt1</interface>
			<ipprotocol>inet</ipprotocol>
			<protocol>icmp</protocol>
			<icmptype>echoreq</icmptype>
			<source><network>opt1</network></source>
			<destination><any></any></destination>
			<disabled></disabled>
			<descr><![CDATA[IoT ping]]></descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>opt1</interface>
			<ipprotocol>inet</ipprotocol>
			<source><network>opt1</network></source>
			<destination><any></any></destination>
			<descr><![CDATA[IoT out]]></descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>openvpn</interface>
			<source><any></any></source>
			<destination><any></any></destination>
			<descr><![CDATA[OpenVPN clients]]></descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>wan</interface>
			<protocol>tcp</protocol>
			<source><any></any></source>
			<destination><address>192.168.10.20</address><port>32400</port></destination>
			<associated-rule-id>nat_5f00000000001</associated-rule-id>
			<tracker>1000000001</tracker>
			<descr><![CDATA[NAT Plex]]></descr>
		</rule>
	</filter>
	<nat>
		<outbound>
			<mode>hybrid</mode>
			<rule>
				<interface>wan</interface>
				<source><network>192.168.10.0/24</network></source>
				<target></target>
				<staticnatport></staticnatport>
				<descr><![CDATA[console static port]]></descr>
			</rule>
		</outbound>
		<rule>
			<interface>wan</interface>
			<protocol>tcp</protocol>
			<source><any></any></source>
			<destination><network>wanip</network><port>32400</port></destination>
			<target>192.168.10.20</target>
			<local-port>32400</local-port>
			<descr><![CDATA[Plex]]></descr>
			<associated-rule-id>nat_5f00000000001</associated-rule-id>
		</rule>
		<rule>
			<interface>wan</interface>
			<protocol>tcp/udp</protocol>
			<source><any></any></source>
			<destination><network>wanip</network><port>3074-3079</port></destination>
			<target>192.168.10.40</target>
			<local-port>3074</local-port>
			<descr><![CDATA[Console]]></descr>
		</rule>
		<rule>
			<interface>wan</interface>
			<protocol>tcp</protocol>
			<source><any></any></source>
			<destination><network>wanip</network><port>2222</port></destination>
			<target>NAS</target>
			<local-port>22</local-port>
			<descr><![CDATA[NAS ssh]]></descr>
		</rule>
		<rule>
			<interface>wan</interface>
			<protocol>tcp/udp</protocol>
			<source><any></any></source>
			<destination><network>wanip</network><port>1-65535</port></destination>
			<target>192.168.10.99</target>
			<local-port>1</local-port>
			<descr><![CDATA[DMZ host]]></descr>
		</rule>
		<rule>
			<interface>wan</interface>
			<protocol>udp</protocol>
			<source><any></any></source>
			<destination><network>wanip</network><port>4000-4010</port></destination>
			<target>192.168.10.41</target>
			<local-port>5000</local-port>
			<descr><![CDATA[Shifted range]]></descr>
		</rule>
		<rule>
			<interface>wan</interface>
			<protocol>tcp</protocol>
			<source><address>203.0.113.7</address></source>
			<destination><network>wanip</network><port>8443</port></destination>
			<target>192.168.10.5</target>
			<local-port>443</local-port>
			<descr><![CDATA[Office only]]></descr>
		</rule>
	</nat>
	<dhcpd>
		<lan>
			<enable></enable>
			<range><from>192.168.10.100</from><to>192.168.10.199</to></range>
			<defaultleasetime>7200</defaultleasetime>
			<dnsserver>192.168.10.1</dnsserver>
			<staticmap>
				<mac>AA:BB:CC:00:00:05</mac>
				<ipaddr>192.168.10.5</ipaddr>
				<hostname>nas</hostname>
			</staticmap>
			<staticmap>
				<mac>aa:bb:cc:00:00:06</mac>
				<ipaddr></ipaddr>
				<hostname>printer</hostname>
			</staticmap>
		</lan>
		<opt1>
			<enable></enable>
			<range><from>192.168.30.100</from><to>192.168.30.150</to></range>
			<domain>iot.example</domain>
		</opt1>
	</dhcpd>
	<dhcpdv6>
		<lan>
			<ramode>assist</ramode>
		</lan>
	</dhcpdv6>
	<unbound>
		<enable></enable>
		<dnssec></dnssec>
		<forwarding></forwarding>
		<hosts>
			<host>nas</host>
			<domain>home.example</domain>
			<ip>192.168.10.5</ip>
			<aliases>
				<item><host>files</host><domain>home.example</domain></item>
			</aliases>
		</hosts>
		<domainoverrides>
			<domain>corp.example</domain>
			<ip>192.0.2.10</ip>
		</domainoverrides>
		<domainoverrides>
			<domain>corp.example</domain>
			<ip>192.0.2.11@5353</ip>
		</domainoverrides>
	</unbound>
	<gateways>
		<gateway_item>
			<interface>wan</interface>
			<gateway>dynamic</gateway>
			<name>WAN_DHCP</name>
			<ipprotocol>inet</ipprotocol>
		</gateway_item>
		<gateway_item>
			<interface>opt2</interface>
			<gateway>198.51.100.1</gateway>
			<name>BACKUP_GW</name>
			<ipprotocol>inet</ipprotocol>
		</gateway_item>
		<gateway_group>
			<name>Failover</name>
			<item>WAN_DHCP|1|address</item>
			<item>BACKUP_GW|2|address</item>
			<item>GONE_GW|3|address</item>
		</gateway_group>
	</gateways>
	<staticroutes>
		<route>
			<network>10.99.0.0/16</network>
			<gateway>BACKUP_GW</gateway>
		</route>
	</staticroutes>
	<openvpn>
		<openvpn-server>
			<description><![CDATA[Road warrior]]></description>
		</openvpn-server>
		<openvpn-client>
			<description><![CDATA[VPN provider]]></description>
		</openvpn-client>
	</openvpn>
	<dyndnses>
		<dyndns><descr>home</descr></dyndns>
	</dyndnses>
	<ca><descr>internal CA</descr><prv>not-a-real-private-key</prv></ca>
	<installedpackages>
		<package><name>miniupnpd</name></package>
		<package><name>pfBlockerNG</name></package>
		<package><name>suricata</name></package>
		<package><name>ntopng</name></package>
		<miniupnpd>
			<config>
				<enable>on</enable>
				<enable_upnp>on</enable_upnp>
				<enable_natpmp>on</enable_natpmp>
				<ext_iface>wan</ext_iface>
				<iface_array>lan,opt1</iface_array>
				<permdefault>on</permdefault>
				<row><permuser>allow 1024-65535 192.168.10.0/24 1024-65535</permuser></row>
				<row><permuser>allow 3074 192.168.10.40/32 3075</permuser></row>
				<row><permuser>deny 0-65535 0.0.0.0/0 0-65535</permuser></row>
			</config>
		</miniupnpd>
		<suricata>
			<rule>
				<interface>lan</interface>
				<enable>on</enable>
				<ips_mode>ips_mode_inline</ips_mode>
				<descr>LAN</descr>
			</rule>
		</suricata>
		<pfblockernglistsv4>
			<config>
				<aliasname>threats</aliasname>
				<action>Deny_Both</action>
				<row>
					<header>abuse</header>
					<url>https://lists.example/abuse.txt</url>
					<state>Enabled</state>
				</row>
				<row>
					<header>old</header>
					<url>https://lists.example/old.txt</url>
					<state>Disabled</state>
				</row>
			</config>
			<config>
				<aliasname>allow</aliasname>
				<action>Permit_Outbound</action>
			</config>
		</pfblockernglistsv4>
		<pfblockerngdnsbl>
			<config>
				<aliasname>ads</aliasname>
				<action>unbound</action>
				<row>
					<header>adlist</header>
					<url>https://lists.example/ads.txt</url>
					<state>Enabled</state>
				</row>
			</config>
		</pfblockerngdnsbl>
	</installedpackages>
</pfsense>
