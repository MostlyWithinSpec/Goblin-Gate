alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"ET MALWARE Win32/Foo CnC Beacon"; flow:established,to_server; content:"foo"; classtype:trojan-activity; sid:2000001; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"ET SCAN Potential SSH Scan"; flags:S; threshold:type both,track by_src,count 5,seconds 120; classtype:attempted-recon; sid:2001219; rev:20;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET INFO curl User-Agent"; http.user_agent; content:"curl"; classtype:not-suspicious; sid:2013028; rev:7;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET POLICY TLS to rare TLD"; classtype:policy-violation; sid:2050000; rev:1;)
alert http any any -> any any (msg:"ET EXPLOIT Something Low"; content:"x"; classtype:protocol-command-decode; sid:2060000; rev:1;)
alert http any any -> any any (msg:"ET EXPLOIT Priority override"; content:"y"; classtype:protocol-command-decode; priority:1; sid:2060001; rev:1;)
alert http any any -> any any (msg:"ET MALWARE set flowbit"; content:"z"; flowbits:set,foo; flowbits:noalert; classtype:trojan-activity; sid:2070000; rev:1;)
drop tcp any any -> any any (msg:"ET DROP Spamhaus DROP Listed Traffic"; classtype:misc-attack; sid:2400000; rev:1;)
alert tcp any any -> any any (msg:"SURICATA STREAM excessive retransmissions"; flowbits:isnotset,tcp.retransmission.alerted; classtype:protocol-command-decode; sid:2210054; rev:1;)
pass ip 192.0.2.1 any -> any any (msg:"local exception"; sid:9000001; rev:1;)
# alert tcp any any -> any any (msg:"ET MALWARE disabled"; sid:2080000; rev:1;)
