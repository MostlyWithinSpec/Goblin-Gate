table ip goblin_nat
delete table ip goblin_nat

table ip goblin_nat {
	chain dns_redirect {
		iifname "eth1.20" meta l4proto { tcp, udp } th dport 53 redirect to :5300 comment "web filter office: guest"
		iifname "eth1" meta l4proto { tcp, udp } th dport 53 redirect to :5300 comment "web filter office: lan"
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		jump dns_redirect
		iifname "eth0" tcp dport 443 dnat to 10.10.0.10 comment "port forward https-in"
		iifname "eth0" tcp dport 8080 dnat to 10.10.0.10:80 comment "port forward alt-web"
		iifname "eth0" udp dport 27000-27010 dnat to 192.168.1.20 comment "port forward game"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname { "eth0", "eth0.7" } meta mark & 0x00000001 == 0x00000001 masquerade comment "policies with nat enabled"
	}
}

table inet goblin_upnp
delete table inet goblin_upnp

table inet goblin_upnp {
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		jump upnp_dnat
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		jump upnp_snat
	}

	chain upnp_dnat {
	}

	chain upnp_snat {
	}
}
