# Generated by Goblin Gate — do not edit
# Multi-WAN routing rules (see internal/render/routing.go)
[Match]
Name=lo

[Network]
LinkLocalAddressing=no
IPv6AcceptRA=no

# LAN and connected routes first, even for marked traffic
[RoutingPolicyRule]
Table=main
SuppressPrefixLength=0
Priority=500

# monitor of gateway wan1
[RoutingPolicyRule]
To=1.1.1.1/32
Table=100
Priority=900

# monitor of gateway wan2
[RoutingPolicyRule]
To=9.9.9.9/32
Table=101
Priority=901

# monitor of gateway vpn
[RoutingPolicyRule]
To=8.8.8.8/32
Table=102
Priority=902

# policies routed to wan1
[RoutingPolicyRule]
FirewallMark=0x00010000/0x00ff0000
Table=200
Priority=1000

# policies routed to wan2
[RoutingPolicyRule]
FirewallMark=0x00020000/0x00ff0000
Table=201
Priority=1001

# policies routed to vpn
[RoutingPolicyRule]
FirewallMark=0x00030000/0x00ff0000
Table=202
Priority=1002

# policies routed to failover
[RoutingPolicyRule]
FirewallMark=0x00040000/0x00ff0000
Table=203
Priority=1003

# policies routed to balance
[RoutingPolicyRule]
FirewallMark=0x00050000/0x00ff0000
Table=204
Priority=1004

# everything else: the default route (goblind)
[RoutingPolicyRule]
Table=250
Priority=32000
